{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medical-insurance.example/contracts/domain.schema.json",
  "title": "医保服务目录映射台领域事件",
  "type": "object",
  "required": ["event_id", "event_type", "aggregate_type", "aggregate_id", "occurred_at", "version", "payload"],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "event_type": {
      "type": "string",
      "enum": [
        "CATALOG_DRAFTED",
        "VERSION_ACTIVATED",
        "ITEM_DISCONTINUED",
        "MAPPING_PROPOSED",
        "MAPPING_APPROVED",
        "LOCAL_RULES_PUBLISHED",
        "CLAIM_PRECHECKED",
        "CLAIM_SETTLED",
        "CLAIM_LINE_FINALIZED",
        "CLAIM_ADJUSTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": ["catalog_version", "national_item", "provincial_item", "mapping_decision", "rule_set", "claim"]
    },
    "aggregate_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "version": { "type": "integer", "minimum": 1 },
    "chain_seq": { "type": "integer", "minimum": 1 },
    "prev_hash": { "type": "string" },
    "released": { "type": "boolean" },
    "release_seq": { "type": ["integer", "null"], "minimum": 1 },
    "prev_release_hash": { "type": ["string", "null"] },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payload": { "$ref": "#/$defs/payload" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "MAPPING_APPROVED" } }, "required": ["event_type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/mappingDecision" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "LOCAL_RULES_PUBLISHED" } }, "required": ["event_type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/ruleSet" } } }
    },
    {
      "if": { "properties": { "event_type": { "const": "VERSION_ACTIVATED" } }, "required": ["event_type"] },
      "then": { "properties": { "payload": { "$ref": "#/$defs/activation" } } }
    }
  ],
  "$defs": {
    "payload": { "type": "object" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "item": {
      "type": "object",
      "required": ["code", "name", "clinical_content", "exclusions", "pricing_unit", "applicable_institutions", "payment_conditions"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "clinical_content": { "type": "string", "minLength": 1, "description": "临床内涵" },
        "exclusions": { "type": "array", "items": { "type": "string" }, "description": "排除项：不得借本项目另行收费的内容" },
        "pricing_unit": { "type": "string", "minLength": 1, "description": "计价单位，如 日/次/部位/穴位" },
        "applicable_institutions": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "payment_conditions": {
          "type": "object",
          "required": ["prior_auth_required"],
          "properties": {
            "prior_auth_required": { "type": "boolean" },
            "note": { "type": "string" }
          }
        },
        "required_materials": { "type": "array", "items": { "type": "string" } },
        "required_combo": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "activation": {
      "type": "object",
      "required": ["catalog_id", "level", "scope", "effective_from", "effective_to"],
      "properties": {
        "catalog_id": { "type": "string" },
        "level": { "type": "string", "enum": ["national", "provincial"] },
        "scope": { "type": "string", "description": "国家填 CN，省级填 6 位行政区划代码" },
        "name": { "type": "string" },
        "effective_from": { "$ref": "#/$defs/date" },
        "effective_to": { "type": ["string", "null"] },
        "announced_at": { "type": ["string", "null"] },
        "notice": { "type": "string", "description": "发布公告/文号" }
      }
    },
    "mappingDecision": {
      "type": "object",
      "required": ["proposal_event_id", "kind", "effective_from", "expert_review", "mapping_basis"],
      "properties": {
        "proposal_event_id": { "type": "string", "description": "机器候选事件编号；人工裁定必须基于候选" },
        "kind": { "type": "string", "enum": ["EQUIVALENT", "ONE_TO_MANY", "MANY_TO_ONE", "PARTIAL_OVERLAP", "UNMAPPED"] },
        "effective_from": { "$ref": "#/$defs/date" },
        "effective_to": { "type": ["string", "null"] },
        "correction_of": { "type": ["string", "null"], "description": "更正所指向的原已发布裁定事件编号" },
        "difference_note": { "type": "string", "description": "非等价映射必须书面说明差异" },
        "rationale": { "type": "string", "description": "保持未映射的书面理由；禁止就近落码" },
        "expert_review": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["expert", "organization", "conclusion", "reviewed_at"],
            "properties": {
              "expert": { "type": "string" },
              "organization": { "type": "string" },
              "conclusion": { "type": "string" },
              "reviewed_at": { "$ref": "#/$defs/date" }
            }
          }
        },
        "mapping_basis": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provincial_ref", "national_ref"],
            "properties": {
              "provincial_ref": { "$ref": "#/$defs/itemRef" },
              "national_ref": { "$ref": "#/$defs/itemRef" },
              "share": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "description": "一对多拆账比例，同一裁定各链接之和为 1" },
              "unit_conversion": {
                "type": "object",
                "required": ["acknowledged", "explanation"],
                "properties": {
                  "acknowledged": { "const": true },
                  "explanation": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "itemRef": {
      "type": "object",
      "required": ["catalog_id", "code"],
      "properties": {
        "catalog_id": { "type": "string" },
        "code": { "type": "string" }
      }
    },
    "ruleSet": {
      "type": "object",
      "required": ["province_code", "effective_from", "rules"],
      "properties": {
        "province_code": { "type": "string", "pattern": "^\\d{6}$", "description": "参保地行政区划代码" },
        "version": { "type": "string" },
        "effective_from": { "$ref": "#/$defs/date" },
        "effective_to": { "type": ["string", "null"] },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["national_code", "category", "coinsurance_self_pay"],
            "properties": {
              "national_code": { "type": "string" },
              "category": { "type": "string", "enum": ["甲", "乙", "丙"] },
              "coinsurance_self_pay": { "type": "number", "minimum": 0, "exclusiveMaximum": 1 },
              "price_cap_yuan": { "type": ["number", "null"] },
              "prior_auth_required": { "type": "boolean" },
              "self_pay_reasons": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
